@*
    //**********************************************************************************
    //* マスタ・テーブル（Suppliers）サンプル（Ｐ層）
    //**********************************************************************************

    //**********************************************************************************
    //* クラス名        ：Index
    //* クラス日本語名  ：画面Ｂ（一覧・行追加／行削除・バッチ更新）
    //*
    //* 作成日時        ：2026/08/12
    //* 作成者          ：コーディング エージェント
    //* 更新履歴        ：
    //*
    //*  日時        更新者            内容
    //*  ----------  ----------------  -------------------------------------------------
    //*  2026/08/12  コーディング Ａ   新規作成
    //**********************************************************************************
*@

@using System
@using System.Data
@model SuppliersViewModel

@{
    ViewBag.Title = "Suppliers 画面Ｂ";
}

@section HeaderScriptsSection{
    <!-- Head 部の section -->
}

<h4>Suppliers 画面Ｂ</h4>
<p>［一覧取得］で一覧を表示し、セルを直接編集できます。行内の［削除］で行削除、グリッド外の［行追加］で行追加、［更新］でまとめてDBへ反映します。</p>

<form id="formB" method="post" asp-controller="SuppliersB" asp-action="SelectAll">
    @Html.AntiForgeryToken()

    @* グリッド外の［追加］ボタン（フッタ部ではない） *@
    <div style="margin-bottom: 8px;">
        <button type="submit" class="btn btn-success btn-sm"
                formaction="@Url.Action("AddRow", "SuppliersB")">行追加</button>
    </div>

    @* 一覧は table タグを自前で生成し、tr をループで実装する *@
    <table class="table table-sm table-bordered">
        <thead>
            <tr>
                <th>SupplierID</th>
                <th>CompanyName</th>
                <th>ContactName</th>
                <th>ContactTitle</th>
                <th>City</th>
                <th>Country</th>
                <th>Phone</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Suppliers != null)
            {
                @* ★ Deleted 行は描画しないので、連番ではなく DataTable の行インデックスを持ち回る。
                     ここは既にコード文脈なので for に @ を付けない（付けると Razor のパース エラー）。 *@
                for (int i = 0; i < Model.Suppliers.Rows.Count; i++)
                {
                    DataRow dr = Model.Suppliers.Rows[i];

                    if (dr.RowState == DataRowState.Deleted)
                    {
                        continue;
                    }

                    @* 追加行は負値で仮採番されている（実際の採番はDB側の IDENTITY） *@
                    string supplierId = (dr["SupplierID"] == DBNull.Value || Convert.ToInt32(dr["SupplierID"]) < 0)
                        ? "(採番)" : dr["SupplierID"].ToString();
                    int idx = i;

                    <tr>
                        <td>
                            @supplierId
                            <input type="hidden" name="Rows[@idx].RowIndex" value="@idx" />
                        </td>
                        <td><input type="text" class="form-control form-control-sm" name="Rows[@idx].CompanyName" value="@(dr["CompanyName"] == DBNull.Value ? "" : dr["CompanyName"].ToString())" /></td>
                        <td><input type="text" class="form-control form-control-sm" name="Rows[@idx].ContactName" value="@(dr["ContactName"] == DBNull.Value ? "" : dr["ContactName"].ToString())" /></td>
                        <td><input type="text" class="form-control form-control-sm" name="Rows[@idx].ContactTitle" value="@(dr["ContactTitle"] == DBNull.Value ? "" : dr["ContactTitle"].ToString())" /></td>
                        <td><input type="text" class="form-control form-control-sm" name="Rows[@idx].City" value="@(dr["City"] == DBNull.Value ? "" : dr["City"].ToString())" /></td>
                        <td><input type="text" class="form-control form-control-sm" name="Rows[@idx].Country" value="@(dr["Country"] == DBNull.Value ? "" : dr["Country"].ToString())" /></td>
                        <td><input type="text" class="form-control form-control-sm" name="Rows[@idx].Phone" value="@(dr["Phone"] == DBNull.Value ? "" : dr["Phone"].ToString())" /></td>
                        <td>
                            @* グリッド中の削除ボタン *@
                            <button type="submit" class="btn btn-danger btn-sm"
                                    formaction="@Url.Action("DeleteRow", "SuppliersB", new { rowIndex = idx })">削除</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</form>

@* フッタ部のメイン ボタン5つ（キャプションは画面ごと、不要なものは disabled） *@
@section FooterButtonsSection{
    <button type="submit" form="formB" class="btn btn-primary" id="btnMain1"
            formaction="@Url.Action("SelectAll", "SuppliersB")">一覧取得</button>
    <button type="submit" form="formB" class="btn btn-warning" id="btnMain2"
            formaction="@Url.Action("BatchUpdate", "SuppliersB")"
            onclick="return window.confirm('更新します。よろしいですか？');">更新</button>
    <button type="button" class="btn btn-secondary" id="btnMain3"
            onclick="location.href='@Url.Action("Index", "SuppliersA")';">戻る</button>
    <button type="button" class="btn btn-secondary" id="btnMain4" disabled>－</button>
    <button type="button" class="btn btn-secondary" id="btnMain5" disabled>－</button>
}

@section FooterScriptsSection{
    <script type="text/javascript">
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <text>window.alert(@Json.Serialize(Model.Message));</text>
        }
    </script>
}
